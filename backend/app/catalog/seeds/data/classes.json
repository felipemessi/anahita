    "features": [
      {
        "index": "fighting-style",
        "level": 1,
        "mechanical_effect": null,
        "i18n": {
          "en": {
            "feature_name": "Fighting Style",
            "description": "You adopt a particular style of fighting as your specialty. Choose one of the following options. You can't take a Fighting Style option more than once, even if you later get to choose again."
          }
        }
      },
      {
        "index": "second-wind",
        "level": 1,
        "mechanical_effect": "second_wind:1d10",
        "i18n": {
          "en": {
            "feature_name": "Second Wind",
            "description": "You have a limited well of stamina that you can draw on to protect yourself from harm. On your turn, you can use a bonus action to regain hit points equal to 1d10 + your fighter level."
          }
        }
      },
      {
        "index": "action-surge-1",
        "level": 2,
        "mechanical_effect": "action_surge:1",
        "i18n": {
          "en": {
            "feature_name": "Action Surge",
            "description": "Starting at 2nd level, you can push yourself beyond your normal limits for a moment. On your turn, you can take one additional action."
          }
        }
      },
      {
        "index": "martial-archetype",
        "level": 3,
        "mechanical_effect": null,
        "i18n": {
          "en": {
            "feature_name": "Martial Archetype",
            "description": "At 3rd level, you choose an archetype that you strive to emulate in your combat styles and techniques."
          }
        }
      },
      {
        "index": "extra-attack-1",
        "level": 5,
        "mechanical_effect": "extra_attack:1",
        "i18n": {
          "en": {
            "feature_name": "Extra Attack",
            "description": "Beginning at 5th level, you can attack twice, instead of once, whenever you take the Attack action on your turn."
          }
        }
      },
      {
        "index": "extra-attack-2",
        "level": 11,
        "mechanical_effect": "extra_attack:2",
        "i18n": {
          "en": {
            "feature_name": "Extra Attack (2)",
            "description": "At 11th level, you can attack three times whenever you take the Attack action on your turn."
          }
        },
        "prerequisites": [
          {
            "prerequisite_type": "feature",
            "required_feature_index": "extra-attack-1"
          }
        ]
      },
      {
        "index": "extra-attack-3",
        "level": 20,
        "mechanical_effect": "extra_attack:3",
        "i18n": {
          "en": {
            "feature_name": "Extra Attack (3)",
            "description": "At 20th level, you can attack four times whenever you take the Attack action on your turn."
          }
        },
        "prerequisites": [
          {
            "prerequisite_type": "feature",
            "required_feature_index": "extra-attack-2"
          }
        ]
      }
    ],
    "subclasses": [
      {
        "index": "champion",
        "i18n": {
          "en": {
            "name": "Champion",
            "description": "The archetypal Champion focuses on the development of raw physical power honed to deadly perfection. Those who model themselves on this archetype combine rigorous training with physical excellence to deal devastating blows.",
            "flavor": ""
          }
        },
        "features": [
          {
            "index": "improved-critical",
            "level": 3,
            "mechanical_effect": "critical_range:19-20",
            "i18n": {
              "en": {
                "feature_name": "Improved Critical",
                "description": "Beginning when you choose this archetype at 3rd level, your weapon attacks score a critical hit on a roll of 19 or 20."
              }
            }
          }
        ]
      },
      {
        "index": "battle-master",
        "i18n": {
          "en": {
            "name": "Battle Master",
            "description": "Those who emulate the archetypal Battle Master employ martial techniques passed down through generations. A Battle Master might be a skilled duelist, a general, or an instructor.",
            "flavor": ""
          }
        },
        "features": [
          {
            "index": "combat-superiority",
            "level": 3,
            "mechanical_effect": "superiority_dice:4d8",
            "i18n": {
              "en": {
                "feature_name": "Combat Superiority",
                "description": "When you choose this archetype at 3rd level, you learn maneuvers that are fueled by special dice called superiority dice."
              }
            }
          }
        ]
      },
      {
        "index": "eldritch-knight",
        "i18n": {
          "en": {
            "name": "Eldritch Knight",
            "description": "The archetypal Eldritch Knight combines the martial mastery common to all fighters with a careful study of magic.",
            "flavor": ""
          }
        },
        "features": [
          {
            "index": "ek-spellcasting",
            "level": 3,
            "mechanical_effect": "spellcasting:intelligence",
            "i18n": {
              "en": {
                "feature_name": "Spellcasting",
                "description": "When you reach 3rd level, you augment your martial prowess with the ability to cast spells."
              }
            }
          }
        ]
      }
    ]
  },
