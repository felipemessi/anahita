# Base URL used by the browser (client-side) API client. In production this
# is proxied by Nginx at /api (see docs/anahita-frontend-prd.md §12.2).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Base URL used by Server Components / the server-side API client to reach
# the backend directly (container-to-container in Docker Compose).
ANAHITA_API_URL=http://localhost:8000
